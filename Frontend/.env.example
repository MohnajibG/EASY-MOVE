# Copie ce fichier en .env.local et remplis avec tes vraies valeurs

# Supabase (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# EmailJS (emailjs.com > Email Services / Email Templates / Account > General)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Elfsight (elfsight.com > My Projects > ton widget)
VITE_ELFSIGHT_REVIEWS_WIDGET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_ELFSIGHT_INSTAGRAM_WIDGET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
